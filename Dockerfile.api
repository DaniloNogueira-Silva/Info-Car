# ============================================
# Stage 1: Builder
# ============================================
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Adiciona as ferramentas necessárias para compilar pacotes nativos
RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx nest build api

# ============================================
# Stage 2: Production
# ============================================
FROM node:20-alpine AS production

WORKDIR /usr/src/app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY package*.json ./

# Cria um grupo virtual (.gyp) com as ferramentas, instala os pacotes e apaga as ferramentas
RUN apk add --no-cache --virtual .gyp python3 make g++ && \
    npm ci --omit=dev && \
    apk del .gyp

COPY --from=builder /usr/src/app/dist/apps/api ./dist

USER nestjs

EXPOSE 3000

CMD ["node", "dist/main.js"]