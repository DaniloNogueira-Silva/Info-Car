{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared(|/.*)$": "<rootDir>/../../../libs/shared/src$1",
    "^@app/infrastructure(|/.*)$": "<rootDir>/../../../libs/infrastructure/src$1",
    "^libs/(.*)$": "<rootDir>/../../../libs/$1"
  }
}
